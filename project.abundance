        {
          "atomType": "Code",
          "x": 0.44,
          "y": 0.65,
          "uniqueID": "id-3214",
          "ioValues": [
            {
              "name": "hullLines",
              "ioValue": "__GEOMETRY_INPUT__"
            },
            {
              "name": "crownRadius",
              "ioValue": 6000
            },
            {
              "name": "top",
              "ioValue": 80,
              "currentEquation": "Height"
            },
            {
              "name": "bottom",
              "ioValue": -69,
              "currentEquation": "-(DeckThickness + Depth)"
            },
            {
              "name": "halfWidth",
              "ioValue": 1000
            },
            {
              "name": "samples",
              "ioValue": 24
            }
          ],
          "interpreterVersion": 1,
          "code": "/**\n * Crowned band: the layer between two surfaces that follow the crowned deck,\n * `top` mm above it and `bottom` mm (negative = below) under it.\n * At each sampled station along the sheer line the deck is an arc of radius\n * `crownRadius` through the port and starboard sheer points. The band's\n * section there is that arc raised by `top` and by `bottom`, spanning\n * +/- `halfWidth`; the sections are lofted into one solid.\n */\nfunction run(hullLines: Assembly, crownRadius: number = 6000, top: number = 80, bottom: number = -69, halfWidth: number = 1000, samples: number = 48): Assembly {\n  let sheer: any = undefined;\n  hullLines.onLeafs((leaf) => {\n    if (!sheer && leaf.isWire() && (leaf.tags || []).includes(\"sheer\")) sheer = leaf.geometry;\n    return leaf;\n  });\n  if (!sheer) throw new Error(\"No wire tagged 'sheer' in the hull lines\");\n  const R = crownRadius, W = halfWidth;\n  const n = Math.max(4, Math.round(samples));\n  const wires: any[] = [];\n  let lastX = -Infinity;\n  for (let i = 0; i <= n; i++) {\n    const p = sheer.pointAt(i / n);\n    if (p.x <= lastX + 1) continue;\n    lastX = p.x;\n    const half = Math.min(Math.abs(p.y), R * 0.999);\n    const zc = p.z - Math.sqrt(R * R - half * half);\n    const zAt = (y: number, off: number) => zc + Math.sqrt(R * R - y * y) + off;\n    const x = p.x;\n    const tA: [number, number, number] = [x, -W, zAt(-W, top)];\n    const tM: [number, number, number] = [x, 0, zAt(0, top)];\n    const tB: [number, number, number] = [x, W, zAt(W, top)];\n    const bB: [number, number, number] = [x, W, zAt(W, bottom)];\n    const bM: [number, number, number] = [x, 0, zAt(0, bottom)];\n    const bA: [number, number, number] = [x, -W, zAt(-W, bottom)];\n    wires.push(replicad.assembleWire([\n      replicad.makeThreePointArc(tA, tM, tB),\n      replicad.makeLine(tB, bB),\n      replicad.makeThreePointArc(bB, bM, bA),\n      replicad.makeLine(bA, tA),\n    ]));\n  }\n  const band = replicad.loft(wires, { ruled: false }, false);\n  return new Assembly({ geometry: band, color: \"#c8b08a\" });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Crowned band: the layer between two surfaces that follow the crowned deck,\n * `top` mm above it and `bottom` mm (negative = below) under it.\n * At each sampled station along the sheer line the deck is an arc of radius\n * `crownRadius` through the port and starboard sheer points. The band's\n * section there is that arc raised by `top` and by `bottom`, spanning\n * +/- `halfWidth`; the sections are lofted into one solid.\n */\nfunction run(hullLines, crownRadius = 6000, top = 80, bottom = -69, halfWidth = 1000, samples = 48) {\n    let sheer = undefined;\n    hullLines.onLeafs((leaf) => {\n        if (!sheer && leaf.isWire() && (leaf.tags || []).includes(\"sheer\"))\n            sheer = leaf.geometry;\n        return leaf;\n    });\n    if (!sheer)\n        throw new Error(\"No wire tagged 'sheer' in the hull lines\");\n    const R = crownRadius, W = halfWidth;\n    const n = Math.max(4, Math.round(samples));\n    const wires = [];\n    let lastX = -Infinity;\n    for (let i = 0; i <= n; i++) {\n        const p = sheer.pointAt(i / n);\n        if (p.x <= lastX + 1)\n            continue;\n        lastX = p.x;\n        const half = Math.min(Math.abs(p.y), R * 0.999);\n        const zc = p.z - Math.sqrt(R * R - half * half);\n        const zAt = (y, off) => zc + Math.sqrt(R * R - y * y) + off;\n        const x = p.x;\n        const tA = [x, -W, zAt(-W, top)];\n        const tM = [x, 0, zAt(0, top)];\n        const tB = [x, W, zAt(W, top)];\n        const bB = [x, W, zAt(W, bottom)];\n        const bM = [x, 0, zAt(0, bottom)];\n        const bA = [x, -W, zAt(-W, bottom)];\n        wires.push(replicad.assembleWire([\n            replicad.makeThreePointArc(tA, tM, tB),\n            replicad.makeLine(tB, bB),\n            replicad.makeThreePointArc(bB, bM, bA),\n            replicad.makeLine(bA, tA),\n        ]));\n    }\n    const band = replicad.loft(wires, { ruled: false }, false);\n    return new Assembly({ geometry: band, color: \"#c8b08a\" });\n}\n"
        },
