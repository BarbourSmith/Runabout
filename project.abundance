            {
              "atomType": "Code",
              "x": 0.45,
              "y": 0.4,
              "uniqueID": "id-6460",
              "ioValues": [
                {
                  "name": "hull",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "rakeDeg",
                  "ioValue": 12.017
                },
                {
                  "name": "xAtKeel",
                  "ioValue": 0.622
                },
                {
                  "name": "sideThickness",
                  "ioValue": 6
                },
                {
                  "name": "bottomThickness",
                  "ioValue": 9
