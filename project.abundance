          "uniqueID": "id-723",
          "name": "util.FaceDifference",
          "ioValues": [
            {
              "name": "faces",
              "ioValue": "__GEOMETRY_INPUT__"
            },
            {
              "name": "cuttingSolid",
              "ioValue": "__GEOMETRY_INPUT__"
            }
          ],
          "topLevel": false,
          "allAtoms": [
            {
              "atomType": "Output",
              "x": 0.98,
              "y": 0.5,
              "uniqueID": "id-719",
              "ioValues": [
                {
                  "name": "number or geometry",
                  "ioValue": "__GEOMETRY_INPUT__"
