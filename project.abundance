new Int32Array(n);\n    for (let r = 0; r < n; r++) {\n        const top = Math.min(b, r);\n        for (let k = top; k >= 1; k--) {\n            if (a[r * (b + 1) + k] !== 0) {\n                envelope[r] = k;\n                break;\n            }\n        }\n    }\n    for (let i = 0; i < n; i++) {\n        const wi = envelope[i];\n        for (let k = wi; k >= 1; k--) {\n            const j = i - k;\n            if (j < 0)\n                continue;\n            let s = a[i * (b + 1) + k];\n            const top = Math.min(wi - k, envelope[j]);\n            for (let m = 1; m <= top; m++) {\n                s -= a[i * (b + 1) + (k + m)] * a[j * (b + 1) + m];\n            }\n            a[i * (b + 1) + k] = s / a[j * (b + 1)];\n        }\n        let d = a[i * (b + 1)];\n        for (let k = 1; k <= wi; k++) {\n            d -= a[i * (b + 1) + k] * a[i * (b + 1) + k];\n        }\n        if (!(d > 0))\n            return null;\n        a[i * (b + 1)] = Math.sqrt(d);\n    }\n    return { n, b, a, envelope };\n}\nfunction solveBanded(m, rx, ry) {\n    const { n, b, a, envelope } = m;\n    const w = b + 1;\n    for (let i = 0; i < n; i++) {\n        let sx = rx[i];\n        let sy = ry[i];\n        const wi = envelope[i];\n        for (let k = 1; k <= wi; k++) {\n            const v = a[i * w + k];\n            sx -= v * rx[i - k];\n            sy -= v * ry[i - k];\n        }\n        const d = a[i * w];\n        rx[i] = sx / d;\n        ry[i] = sy / d;\n    }\n    for (let i = n - 1; i >= 0; i--) {\n        const d = a[i * w];\n        const vx = rx[i] / d;\n        const vy = ry[i] / d;\n        rx[i] = vx;\n        ry[i] = vy;\n        const wi = envelope[i];\n        for (let k = 1; k <= wi; k++) {\n            const v = a[i * w + k];\n            rx[i - k] -= v * vx;\n            ry[i - k] -= v * vy;\n        }\n    }\n}\nfunction intrinsicScale(tris) {\n    let area = 0;\n    for (const tri of tris)\n        area += tri.area;\n    return area > 0 ? Math.sqrt(a