              "x": 0.44,
              "y": 0.65,
              "uniqueID": "id-7691",
              "ioValues": [
                {
                  "name": "hull",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "crownRadius",
                  "ioValue": 6000
                },
                {
                  "name": "top",
                  "ioValue": 80,
                  "currentEquation": "Height"
                },
                {
                  "name": "bottom",
                  "ioValue": -69,
                  "currentEquation": "-(DeckThickness + Depth)"
                },
                {
                  "name": "halfWidth",
                  "ioValue": 1000
                },
                {
                  "name": "samples",
                  "ioValue": 24
                }
              ],
              "interpreterVersion": 1,
              "code": "/**\n * Crowned band: the layer between two surfaces that follow the crowned deck,\n * `top` mm above it and `bottom` mm (negative = below) under it.\n * At each sampled station along the sheer (the top edge of the hull surface,\n * from the transom forward) the deck is an arc of radius `crownRadius` through\n * the port and starboard sheer points. The band's section there is that arc\n * raised by `top` and by `bottom`, spanning +/- `halfWidth`; the sections are\n * lofted into one solid.\n */\nfunction run(hull: Assembly, crownRadius: number = 6000, top: number = 80, bottom: number = -69, halfWidth: number = 1000, samples: number = 24): Assembly {\n  const sheer = sheerOf(hull);\n  const R = crownRadius, W = halfWidth;\n  const n = Math.max(4, Math.round(samples));\n  const wires: any[] = [];\n  let lastX = -Infinity;\n  for (let i = 0; i <= n; i++) {\n    const p = sheer.pointAt(i / n);\n    if (p.x <= lastX + 1) continue;\n    lastX = p.x;\n    const half = Math.min(Math.abs(p.y), R * 0.999);\n    const zc = p.z - Math.sqrt(R * R - half * half);\n    const zAt = (y: number, off: number) => zc + Math.sqrt(R * R - y * y) + off;\n    const x = p.x;\n    const tA: [number, number, number] = [x, -W, zAt(-W, top)];\n    const tM: [number, number, number] = [x, 0, zAt(0, top)];\n    const tB: [number, number, number] = [x, W, zAt(W, top)];\n    const bB: [number, number, number] = [x, W, zAt(W, bottom)];\n    const bM: [number, number, number] = [x, 0, zAt(0, bottom)];\n    const bA: [number, number, number] = [x, -W, zAt(-W, bottom)];\n    wires.push(replicad.assembleWire([\n      replicad.makeThreePointArc(tA, tM, tB),\n      replicad.makeLine(tB, bB),\n      replicad.makeThreePointArc(bB, bM, bA),\n      replicad.makeLine(bA, tA),\n    ]));\n  }\n  const band = replicad.loft(wires, { ruled: false }, false);\n  return new Assembly({ geometry: band, color: \"#c8b08a\" });\n}\n\n// The sheer: the highest edge of the hull surface that runs along the boat,\n// read so that pointAt(0) is its aft end (at the transom).\nfunction sheerOf(hull: Assembly): any {\n  let best: any = null, bestZ = -Infinity;\n  hull.onLeafs((leaf: any) => {\n    const g: any = leaf.geometry;\n    if (g && g.edges) for (const e of g.edges) {\n      const a = e.pointAt(0), b = e.pointAt(1);\n      if (Math.abs(b.x - a.x) < 1000) continue;\n      const z = e.pointAt(0.5).z;\n      if (z > bestZ) { bestZ = z; best = e; }\n    }\n    return leaf;\n  });\n  if (!best) throw new Error(\"No sheer edge in the hull surface\");\n  const fwd = best.pointAt(1).x > best.pointAt(0).x;\n  return { pointAt: (t: number) => best.pointAt(fwd ? t : 1 - t) };\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Crowned band: the layer between two surfaces that follow the crowned deck,\n * `top` mm above it and `bottom` mm (negative = below) under it.\n * At each sampled station along the sheer (the top edge of the hull surface,\n * from the transom forward) the deck is an arc of radius `crownRadius` through\n * the port and starboard sheer points. The band's section there is that arc\n * raised by `top` and by `bottom`, spanning +/- `halfWidth`; the sections are\n * lofted into one solid.\n */\nfunction run(hull, crownRadius = 6000, top = 80, bottom = -69, halfWidth = 1000, samples = 24) {\n    const sheer = sheerOf(hull);\n    const R = crownRadius, W = halfWidth;\n    const n = Math.max(4, Math.round(samples));\n    const wires = [];\n    let lastX = -Infinity;\n    for (let i = 0; i <= n; i++) {\n        const p = sheer.pointAt(i / n);\n        if (p.x <= lastX + 1)\n            continue;\n        lastX = p.x;\n        const half = Math.min(Math.abs(p.y), R * 0.999);\n        const zc = p.z - Math.sqrt(R * R - half * half);\n        const zAt = (y, off) => zc + Math.sqrt(R * R - y * y) + off;\n        const x = p.x;\n        const tA = [x, -W, zAt(-W, top)];\n        const tM = [x, 0, zAt(0, top)];\n        const tB = [x, W, zAt(W, top)];\n        const bB = [x, W, zAt(W, bottom)];\n        const bM = [x, 0, zAt(0, bottom)];\n        const bA = [x, -W, zAt(-W, bottom)];\n        wires.push(replicad.assembleWire([\n            replicad.makeThreePointArc(tA, tM, tB),\n            replicad.makeLine(tB, bB),\n            replicad.makeThreePointArc(bB, bM, bA),\n            replicad.makeLine(bA, tA),\n        ]));\n    }\n    const band = replicad.loft(wires, { ruled: false }, false);\n    return new Assembly({ geometry: band, color: \"#c8b08a\" });\n}\n// The sheer: the highest edge of the hull surface that runs along the boat,\n// read so that pointAt(0) is its aft end (at the transom).\nfunction sheerOf(hull) {\n    let best = null, bestZ = -Infinity;\n    hull.onLeafs((leaf) => {\n        const g = leaf.geometry;\n        if (g && g.edges)\n            for (const e of g.edges) {\n                const a = e.pointAt(0), b = e.pointAt(1);\n                if (Math.abs(b.x - a.x) < 1000)\n                    continue;\n                const z = e.pointAt(0.5).z;\n                if (z > bestZ) {\n                    bestZ = z;\n                    best = e;\n                }\n            }\n        return leaf;\n    });\n    if (!best)\n        throw new Error(\"No sheer edge in the hull surface\");\n    const fwd = best.pointAt(1).x > best.pointAt(0).x;\n    return { pointAt: (t) => best.pointAt(fwd ? t : 1 - t) };\n}\n"
            },
