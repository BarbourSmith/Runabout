   if (den < 1e-12)\n        return null;\n    const ex = flat[ids[j]].x - flat[ids[i]].x;\n    const ey = flat[ids[j]].y - flat[ids[i]].y;\n    const sr = (ex * dx + ey * dy) / den;\n    const si = (ey * dx - ex * dy) / den;\n    const norm = Math.hypot(sr, si);\n    if (norm < 1e-12)\n        return null;\n    const cr = sr / norm;\n    const ci = si / norm;\n    const vx = xs[k].x - xs[i].x;\n    const vy = xs[k].y - xs[i].y;\n    return {\n        x: flat[ids[i]].x + cr * vx - ci * vy,\n        y: flat[ids[i]].y + ci * vx + cr * vy,\n    };\n}\nexport function canonicalise(flat) {\n    if (flat.length === 0)\n        return flat;\n    let cx = 0;\n    let cy = 0;\n    for (const p of flat) {\n        cx += p.x;\n        cy += p.y;\n    }\n    cx /= flat.length;\n    cy /= flat.length;\n    let sxx = 0;\n    let sxy = 0;\n    let syy = 0;\n    for (const p of flat) {\n        const dx = p.x - cx;\n        const dy = p.y - cy;\n        sxx += dx * dx;\n        sxy += dx * dy;\n        syy += dy * dy;\n    }\n    const ang = 0.5 * Math.atan2(2 * sxy, sxx - syy);\n    const co = Math.cos(-ang);\n    const si = Math.sin(-ang);\n    let minX = Infinity;\n    let minY = Infinity;\n    const out = flat.map((p) => {\n        const dx = p.x - cx;\n        const dy = p.y - cy;\n        const q = { x: co * dx - si * dy, y: si * dx + co * dy };\n        if (q.x < minX)\n            minX = q.x;\n        if (q.y < minY)\n            minY = q.y;\n        return q;\n    });\n    for (const q of out) {\n        q.x -= minX;\n        q.y -= minY;\n    }\n    return out;\n}\nexport function boundaryEdges(mesh) {\n    const used = new Map();\n    const key = (a, b) => (a < b ? `${a}-${b}` : `${b}-${a}`);\n    for (const [a, b, c] of mesh.tris) {\n        for (const [u, v] of [\n            [a, b],\n            [b, c],\n            [c, a],\n        ]) {\n            used.set(key(u, v), (used.get(key(u, v)) ?? 0) + 1);\n        }\n    }\n    const out = [];\n    for (const [a, b, c] o