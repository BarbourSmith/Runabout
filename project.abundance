        {
          "atomType": "GitHubMolecule",
          "x": 0.2255,
          "y": 0.3324,
          "uniqueID": "id-3767",
          "name": "select.FacesByNormal",
          "ioValues": [
            {
              "name": "shape",
              "ioValue": "__GEOMETRY_INPUT__"
            },
            {
              "name": "normal",
              "ioValue": [
                0,
