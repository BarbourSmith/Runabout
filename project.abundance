            },
            {
              "atomType": "Code",
              "x": 0.45,
              "y": 0.3,
              "uniqueID": "id-6444",
              "ioValues": [
                {
                  "name": "hull",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "stations",
                  "ioValue": [
                    700,
                    1400,
                    2100,
                    2800,
                    3500
                  ]
                },
                {
                  "name": "band",
                  "ioValue": 90
                },
                {
                  "name": "sideThickness",
                  "ioValue": 6
                },
                {
                  "name": "bottomThickness",
                  "ioValue": 9
                },
                {
                  "name": "deckThickness",
                  "ioValue": 9
                },
                {
                  "name": "crownRadius",
                  "ioValue": 6000
                }
              ],
              "interpreterVersion": 1,
              "code": "/**\n * Frame outlines from the hull surface. At each station the edges of the side\n * and bottom planking strips cross the station plane; joined, they are the\n * outside of the hull there. That outline is moved inward by the planking\n * thickness (side or bottom), capped by the crowned deck (radius crownRadius\n * through the sheer, lowered by the deck thickness), mirrored to port and\n * hollowed into a ring `band` wide. One sketch per station, in station order,\n * with X = boat y and Y = boat z: Extrude, Rotate and crv.PolyMove atoms stand\n * them up as frames at their stations. Edges are square; bevel them by hand.\n * (One atom draws all the rings because they are cuts through the same hull at\n * the one list of stations that the notches also use.)\n */\nfunction run(\n  hull: Assembly,\n  stations: number[] = [700, 1400, 2100, 2800, 3500],\n  band: number = 90,\n  sideThickness: number = 6,\n  bottomThickness: number = 9,\n  deckThickness: number = 9,\n  crownRadius: number = 6000,\n): Assembly {\n  const side = hullLines(tagged(hull, \"side surface\"));\n  const bottom = hullLines(tagged(hull, \"bottom surface\"));\n  if (!side.length) throw new Error(\"No faces tagged 'side surface' in the hull\");\n  const rings = stations.map((st: number) => {\n    const s = Number(st);\n    const o = outsideAt(side, bottom, s, sideThickness, bottomThickness);\n    if (!o) throw new Error(`No hull section at x = ${s}`);\n    const top = deckUnderside(o.pts[0][0], o.pts[0][1], crownRadius, deckThickness);\n    const outline = mirroredOutline(insideHalf(inset(o.pts, o.t), top), top(0));\n    let ring = outline;\n    try {\n      ring = outline.cut(outline.offset(-band));\n    } catch (e) {\n      console.warn(`frame at ${s}: kept solid, the ring offset failed (${e})`);\n    }\n    return new Assembly({ geometry: ring, tags: [`station ${s}`] });\n  });\n  return new Assembly({ geometry: rings }).skipDisjointPostprocess();\n}\n\n// ---- hull section helpers (shared by the frame, transom, stem and keel hog outlines) ----\ntype P = number[];\n\n// Faces of the hull carrying `tag`, on the face itself or on a group above it.\nfunction tagged(hull: any, tag: string): any[] {\n  const out: any[] = [];\n  const walk = (node: any, has: boolean) => {\n    const h = has || (node.tags || []).includes(tag);\n    if (Array.isArray(node.geometry)) node.geometry.forEach((c: any) => walk(c, h));\n    else if (h && node.geometry) out.push(node.geometry);\n  };\n  walk(hull, false);\n  return out;\n}\n\n// The edges of strip faces that run along the boat: the hull lines.\nfunction hullLines(faces: any[]): any[] {\n  const out: any[] = [];\n  for (const f of faces) for (const e of f.edges) {\n    const a = e.pointAt(0), b = e.pointAt(1);\n    if (Math.abs(b.x - a.x) > 300) out.push({ e, lo: Math.min(a.x, b.x), hi: Math.max(a.x, b.x) });\n  }\n  return out;\n}\n\n// Where a hull line crosses the plane x = s, as [y, z].\nfunction crossX(l: any, s: number): P | null {\n  if (s <= l.lo || s >= l.hi) return null;\n  let lo = 0, hi = 1, flo = l.e.pointAt(0).x - s;\n  if (flo * (l.e.pointAt(1).x - s) > 0) return null;\n  for (let i = 0; i < 40; i++) {\n    const m = (lo + hi) / 2, fm = l.e.pointAt(m).x - s;\n    if ((fm < 0) === (flo < 0)) { lo = m; flo = fm; } else hi = m;\n  }\n  const p = l.e.pointAt((lo + hi) / 2);\n  return [p.y, p.z];\n}\n\nfunction uniq(pts: P[]): P[] {\n  const out: P[] = [];\n  for (const p of pts) if (!out.some((q) => Math.hypot(q[0] - p[0], q[1] - p[1]) < 0.5)) out.push(p);\n  return out;\n}\n\n// Outside of the hull at x = s: points from the sheer down the side, then\n// across the bottom to the keel, with the planking thickness of each segment.\nfunction outsideAt(side: any[], bottom: any[], s: number, sideT: number, bottomT: number) {\n  const sp = uniq(side.map((l) => crossX(l, s)).filter((p) => p) as P[]).sort((a, b) => b[1] - a[1]);\n  const bp = uniq(bottom.map((l) => crossX(l, s)).filter((p) => p) as P[]).sort((a, b) => b[0] - a[0]);\n  return joinOutside(sp, bp, sideT, bottomT);\n}\n\nfunction joinOutside(sp: P[], bp: P[], sideT: number, bottomT: number) {\n  if (sp.length < 2) return null;\n  const pts: P[] = [...sp];\n  const t: number[] = sp.slice(1).map(() => sideT);\n  for (const p of bp) {\n    const last = pts[pts.length - 1];\n    if (Math.hypot(last[0] - p[0], last[1] - p[1]) < 0.5) continue; // the chine, shared\n    t.push(bottomT);\n    pts.push(p);\n  }\n  return { pts, t };\n}\n\n// The same outline moved inward by each segment's thickness, corners mitred\n// (or averaged where the segments are nearly in line or the mitre is long).\nfunction inset(O: P[], t: number[]): P[] {\n  const n = O.length, L: any[] = [];\n  for (let i = 0; i < n - 1; i++) {\n    const dy = O[i + 1][0] - O[i][0], dz = O[i + 1][1] - O[i][1], len = Math.hypot(dy, dz) || 1;\n    const v = [dy / len, dz / len], N = [v[1], -v[0]]; // inboard of the side, above the bottom\n    L.push({ p: [O[i][0] + t[i] * N[0], O[i][1] + t[i] * N[1]], v, N, t: t[i] });\n  }\n  const Q: P[] = [L[0].p];\n  for (let j = 1; j < n - 1; j++) {\n    const a = L[j - 1], b = L[j];\n    const mean = [O[j][0] + 0.5 * (a.t * a.N[0] + b.t * b.N[0]), O[j][1] + 0.5 * (a.t * a.N[1] + b.t * b.N[1])];\n    const cr = a.v[0] * b.v[1] - a.v[1] * b.v[0];\n    if (Math.abs(cr) < 0.25) { Q.push(mean); continue; }\n    const k = ((b.p[0] - a.p[0]) * b.v[1] - (b.p[1] - a.p[1]) * b.v[0]) / cr;\n    const q = [a.p[0] + a.v[0] * k, a.p[1] + a.v[1] * k];\n    Q.push(Math.hypot(q[0] - O[j][0], q[1] - O[j][1]) > 3 * Math.max(a.t, b.t) ? mean : q);\n  }\n  const z = L[n - 2];\n  Q.push([O[n - 1][0] + z.t * z.N[0], O[n - 1][1] + z.t * z.N[1]]);\n  return Q;\n}\n\n// The crowned deck's underside over a section whose sheer is (ys, zs).\nfunction deckUnderside(ys: number, zs: number, R: number, deckT: number) {\n  const zc = zs - Math.sqrt(R * R - ys * ys);\n  return (y: number) => zc + Math.sqrt(R * R - y * y) - deckT;\n}\n\n// Starboard half of the inside outline, from where it meets the deck's\n// underside down to the centreline: [[y, z], ...], last point on y = 0.\nfunction insideHalf(Q: P[], top: (y: number) => number): P[] {\n  const k = Q.findIndex((q) => q[1] <= top(q[0]));\n  if (k < 0) throw new Error(\"The section never gets below the deck\");\n  const S: P[] = [];\n  if (k === 0) S.push(Q[0]);\n  else {\n    const a = Q[k - 1], b = Q[k];\n    let lo = 0, hi = 1;\n    for (let i = 0; i < 50; i++) {\n      const m = (lo + hi) / 2, y = a[0] + (b[0] - a[0]) * m, z = a[1] + (b[1] - a[1]) * m;\n      if (z > top(y)) lo = m; else hi = m;\n    }\n    const m = (lo + hi) / 2;\n    S.push([a[0] + (b[0] - a[0]) * m, a[1] + (b[1] - a[1]) * m]);\n  }\n  for (let i = k; i < Q.length; i++) {\n    const q = Q[i], a = S[S.length - 1];\n    if (q[0] <= 0) { S.push([0, a[1] + ((q[1] - a[1]) * a[0]) / (a[0] - q[0])]); return tidy(S); }\n    S.push(q);\n  }\n  S.push([0, S[S.length - 1][1]]);\n  return tidy(S);\n}\n\nfunction tidy(S: P[]): P[] {\n  return S.filter((p, i) => i === 0 || Math.hypot(p[0] - S[i - 1][0], p[1] - S[i - 1][1]) > 0.01);\n}\n\n// Closed outline from a starboard half: down the starboard side, up the\n// mirrored port side, and back across along the deck through (0, topMid).\nfunction mirroredOutline(S: P[], topMid: number) {\n  let pen = replicad.draw([S[0][0], S[0][1]]);\n  for (let i = 1; i < S.length; i++) pen = pen.lineTo([S[i][0], S[i][1]]);\n  for (let i = S.length - 2; i >= 0; i--) pen = pen.lineTo([-S[i][0], S[i][1]]);\n  return pen.threePointsArcTo([S[0][0], S[0][1]], [0, topMid]).close();\n}\n\n// Inside of the planking at x = s, as [y, z] points, or null outside the hull.\nfunction insideAt(side: any[], bottom: any[], s: number, sideT: number, bottomT: number): P[] | null {\n  const o = outsideAt(side, bottom, s, sideT, bottomT);\n  return o ? inset(o.pts, o.t) : null;\n}\n\n// Height of the inside of the planking where it passes y = c (going down).\nfunction heightAtY(Q: P[], c: number): number | null {\n  for (let i = 0; i < Q.length - 1; i++) {\n    const a = Q[i], b = Q[i + 1];\n    if (a[0] >= c && b[0] < c) return a[1] + ((b[1] - a[1]) * (a[0] - c)) / (a[0] - b[0]);\n  }\n  return null;\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Frame outlines from the hull surface. At each station the edges of the side\n * and bottom planking strips cross the station plane; joined, they are the\n * outside of the hull there. That outline is moved inward by the planking\n * thickness (side or bottom), capped by the crowned deck (radius crownRadius\n * through the sheer, lowered by the deck thickness), mirrored to port and\n * hollowed into a ring `band` wide. One sketch per station, in station order,\n * with X = boat y and Y = boat z: Extrude, Rotate and crv.PolyMove atoms stand\n * them up as frames at their stations. Edges are square; bevel them by hand.\n * (One atom draws all the rings because they are cuts through the same hull at\n * the one list of stations that the notches also use.)\n */\nfunction run(hull, stations = [700, 1400, 2100, 2800, 3500], band = 90, sideThickness = 6, bottomThickness = 9, deckThickness = 9, crownRadius = 6000) {\n    const side = hullLines(tagged(hull, \"side surface\"));\n    const bottom = hullLines(tagged(hull, \"bottom surface\"));\n    if (!side.length)\n        throw new Error(\"No faces tagged 'side surface' in the hull\");\n    const rings = stations.map((st) => {\n        const s = Number(st);\n        const o = outsideAt(side, bottom, s, sideThickness, bottomThickness);\n        if (!o)\n            throw new Error(`No hull section at x = ${s}`);\n        const top = deckUnderside(o.pts[0][0], o.pts[0][1], crownRadius, deckThickness);\n        const outline = mirroredOutline(insideHalf(inset(o.pts, o.t), top), top(0));\n        let ring = outline;\n        try {\n            ring = outline.cut(outline.offset(-band));\n        }\n        catch (e) {\n            console.warn(`frame at ${s}: kept solid, the ring offset failed (${e})`);\n        }\n        return new Assembly({ geometry: ring, tags: [`station ${s}`] });\n    });\n    return new Assembly({ geometry: rings }).skipDisjointPostprocess();\n}\n// Faces of the hull carrying `tag`, on the face itself or on a group above it.\nfunction tagged(hull, tag) {\n    const out = [];\n    const walk = (node, has) => {\n        const h = has || (node.tags || []).includes(tag);\n        if (Array.isArray(node.geometry))\n            node.geometry.forEach((c) => walk(c, h));\n        else if (h && node.geometry)\n            out.push(node.geometry);\n    };\n    walk(hull, false);\n    return out;\n}\n// The edges of strip faces that run along the boat: the hull lines.\nfunction hullLines(faces) {\n    const out = [];\n    for (const f of faces)\n        for (const e of f.edges) {\n            const a = e.pointAt(0), b = e.pointAt(1);\n            if (Math.abs(b.x - a.x) > 300)\n                out.push({ e, lo: Math.min(a.x, b.x), hi: Math.max(a.x, b.x) });\n        }\n    return out;\n}\n// Where a hull line crosses the plane x = s, as [y, z].\nfunction crossX(l, s) {\n    if (s <= l.lo || s >= l.hi)\n        return null;\n    let lo = 0, hi = 1, flo = l.e.pointAt(0).x - s;\n    if (flo * (l.e.pointAt(1).x - s) > 0)\n        return null;\n    for (let i = 0; i < 40; i++) {\n        const m = (lo + hi) / 2, fm = l.e.pointAt(m).x - s;\n        if ((fm < 0) === (flo < 0)) {\n            lo = m;\n            flo = fm;\n        }\n        else\n            hi = m;\n    }\n    const p = l.e.pointAt((lo + hi) / 2);\n    return [p.y, p.z];\n}\nfunction uniq(pts) {\n    const out = [];\n    for (const p of pts)\n        if (!out.some((q) => Math.hypot(q[0] - p[0], q[1] - p[1]) < 0.5))\n            out.push(p);\n    return out;\n}\n// Outside of the hull at x = s: points from the sheer down the side, then\n// across the bottom to the keel, with the planking thickness of each segment.\nfunction outsideAt(side, bottom, s, sideT, bottomT) {\n    const sp = uniq(side.map((l) => crossX(l, s)).filter((p) => p)).sort((a, b) => b[1] - a[1]);\n    const bp = uniq(bottom.map((l) => crossX(l, s)).filter((p) => p)).sort((a, b) => b[0] - a[0]);\n    return joinOutside(sp, bp, sideT, bottomT);\n}\nfunction joinOutside(sp, bp, sideT, bottomT) {\n    if (sp.length < 2)\n        return null;\n    const pts = [...sp];\n    const t = sp.slice(1).map(() => sideT);\n    for (const p of bp) {\n        const last = pts[pts.length - 1];\n        if (Math.hypot(last[0] - p[0], last[1] - p[1]) < 0.5)\n            continue; // the chine, shared\n        t.push(bottomT);\n        pts.push(p);\n    }\n    return { pts, t };\n}\n// The same outline moved inward by each segment's thickness, corners mitred\n// (or averaged where the segments are nearly in line or the mitre is long).\nfunction inset(O, t) {\n    const n = O.length, L = [];\n    for (let i = 0; i < n - 1; i++) {\n        const dy = O[i + 1][0] - O[i][0], dz = O[i + 1][1] - O[i][1], len = Math.hypot(dy, dz) || 1;\n        const v = [dy / len, dz / len], N = [v[1], -v[0]]; // inboard of the side, above the bottom\n        L.push({ p: [O[i][0] + t[i] * N[0], O[i][1] + t[i] * N[1]], v, N, t: t[i] });\n    }\n    const Q = [L[0].p];\n    for (let j = 1; j < n - 1; j++) {\n        const a = L[j - 1], b = L[j];\n        const mean = [O[j][0] + 0.5 * (a.t * a.N[0] + b.t * b.N[0]), O[j][1] + 0.5 * (a.t * a.N[1] + b.t * b.N[1])];\n        const cr = a.v[0] * b.v[1] - a.v[1] * b.v[0];\n        if (Math.abs(cr) < 0.25) {\n            Q.push(mean);\n            continue;\n        }\n        const k = ((b.p[0] - a.p[0]) * b.v[1] - (b.p[1] - a.p[1]) * b.v[0]) / cr;\n        const q = [a.p[0] + a.v[0] * k, a.p[1] + a.v[1] * k];\n        Q.push(Math.hypot(q[0] - O[j][0], q[1] - O[j][1]) > 3 * Math.max(a.t, b.t) ? mean : q);\n    }\n    const z = L[n - 2];\n    Q.push([O[n - 1][0] + z.t * z.N[0], O[n - 1][1] + z.t * z.N[1]]);\n    return Q;\n}\n// The crowned deck's underside over a section whose sheer is (ys, zs).\nfunction deckUnderside(ys, zs, R, deckT) {\n    const zc = zs - Math.sqrt(R * R - ys * ys);\n    return (y) => zc + Math.sqrt(R * R - y * y) - deckT;\n}\n// Starboard half of the inside outline, from where it meets the deck's\n// underside down to the centreline: [[y, z], ...], last point on y = 0.\nfunction insideHalf(Q, top) {\n    const k = Q.findIndex((q) => q[1] <= top(q[0]));\n    if (k < 0)\n        throw new Error(\"The section never gets below the deck\");\n    const S = [];\n    if (k === 0)\n        S.push(Q[0]);\n    else {\n        const a = Q[k - 1], b = Q[k];\n        let lo = 0, hi = 1;\n        for (let i = 0; i < 50; i++) {\n            const m = (lo + hi) / 2, y = a[0] + (b[0] - a[0]) * m, z = a[1] + (b[1] - a[1]) * m;\n            if (z > top(y))\n                lo = m;\n            else\n                hi = m;\n        }\n        const m = (lo + hi) / 2;\n        S.push([a[0] + (b[0] - a[0]) * m, a[1] + (b[1] - a[1]) * m]);\n    }\n    for (let i = k; i < Q.length; i++) {\n        const q = Q[i], a = S[S.length - 1];\n        if (q[0] <= 0) {\n            S.push([0, a[1] + ((q[1] - a[1]) * a[0]) / (a[0] - q[0])]);\n            return tidy(S);\n        }\n        S.push(q);\n    }\n    S.push([0, S[S.length - 1][1]]);\n    return tidy(S);\n}\nfunction tidy(S) {\n    return S.filter((p, i) => i === 0 || Math.hypot(p[0] - S[i - 1][0], p[1] - S[i - 1][1]) > 0.01);\n}\n// Closed outline from a starboard half: down the starboard side, up the\n// mirrored port side, and back across along the deck through (0, topMid).\nfunction mirroredOutline(S, topMid) {\n    let pen = replicad.draw([S[0][0], S[0][1]]);\n    for (let i = 1; i < S.length; i++)\n        pen = pen.lineTo([S[i][0], S[i][1]]);\n    for (let i = S.length - 2; i >= 0; i--)\n        pen = pen.lineTo([-S[i][0], S[i][1]]);\n    return pen.threePointsArcTo([S[0][0], S[0][1]], [0, topMid]).close();\n}\n// Inside of the planking at x = s, as [y, z] points, or null outside the hull.\nfunction insideAt(side, bottom, s, sideT, bottomT) {\n    const o = outsideAt(side, bottom, s, sideT, bottomT);\n    return o ? inset(o.pts, o.t) : null;\n}\n// Height of the inside of the planking where it passes y = c (going down).\nfunction heightAtY(Q, c) {\n    for (let i = 0; i < Q.length - 1; i++) {\n        const a = Q[i], b = Q[i + 1];\n        if (a[0] >= c && b[0] < c)\n            return a[1] + ((b[1] - a[1]) * (a[0] - c)) / (a[0] - b[0]);\n    }\n    return null;\n}\n"
