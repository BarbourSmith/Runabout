              "interpreterVersion": 1,
              "code": "/**\n * Keel hog profile: side view of the keel hog, a timber 2 x halfWidth wide and\n * `depth` deep lying on the bottom planking along the centreline, from the\n * transom to x = endX. Its lower edge is where the inside of the planking\n * passes y = halfWidth, so it bears on the planking at its edges; its aft end\n * follows the raked transom. Returns a sketch with X = boat x and Y = boat z\n * for Extrude, Rotate and Move atoms.\n */\nfunction run(\n  hull: Assembly,\n  endX: number = 3300,\n  halfWidth: number = 32,\n  depth: number = 34,\n  step: number = 50,\n  rakeDeg: number = 12.017,\n  xAtKeel: number = 0.622,\n  sideThickness: number = 6,\n  bottomThickness: number = 9,\n): Assembly {\n  const side = hullLines(tagged(hull, \"side surface\"));\n  const bottom = hullLines(tagged(hull, \"bottom surface\"));\n  const tr = Math.tan((rakeDeg * Math.PI) / 180);\n  const xs: number[] = [];\n  for (let x = 5; x < endX; x += step) xs.push(x);\n  xs.push(endX);\n  const lower: P[] = [];\n  for (const x of xs) {\n    const o = outsideAt(side, bottom, x, sideThickness, bottomThickness);\n    const z = o ? heightAtY(inset(o.pts, o.t), halfWidth) : null;\n    if (z !== null) lower.push([x, z]);\n  }\n  if (lower.length < 2) throw new Error(\"No hull sections along the keel\");\n  const z0 = lower[0][1];\n  let pen = replicad.draw([xAtKeel - z0 * tr, z0]); // aft end on the transom plane\n  for (const p of lower) pen = pen.lineTo(p);\n  for (let i = lower.length - 1; i >= 0; i--) pen = pen.lineTo([lower[i][0], lower[i][1] + depth]);\n  pen = pen.lineTo([xAtKeel - (z0 + depth) * tr, z0 + depth]);\n  return new Assembly({ geometry: pen.close(), tags: [\"keel hog\"] });\n}\n\n// ---- hull section helpers (shared by the frame, transom, stem and keel hog outlines) ----\ntype P = number[];\n\n// Faces of the hull carrying `tag`, on the face itself or on a group above it.\nfunction tagged(hull: any, tag: string): any[] {\n  const out: any[] = [];\n  const walk = (node: any, has: boolean) => {\n    const h = has || (node.tags || []).includes(tag);\n    if (Array.isArray(node.geometry)) node.geometry.forEach((c: any) => walk(c, h));\n    else if (h && node.geometry) out.push(node.geometry);\n  };\n  walk(hull, false);\n  return out;\n}\n\n// The edges of strip faces that run along the boat: the hull lines.\nfunction hullLines(faces: any[]): any[] {\n  const out: any[] = [];\n  for (const f of faces) for (const e of f.edges) {\n    const a = e.pointAt(0), b = e.pointAt(1);\n    if (Math.abs(b.x - a.x) > 10) out.push({ e, lo: Math.min(a.x, b.x), hi: Math.max(a.x, b.x) });\n  }\n  return out;\n}\n\n// Where a hull line crosses the plane x = s, as [y, z].\nfunction crossX(l: any, s: number): P | null {\n  if (s <= l.lo || s >= l.hi) return null;\n  let lo = 0, hi = 1, flo = l.e.pointAt(0).x - s;\n  if (flo * (l.e.pointAt(1).x - s) > 0) return null;\n  for (let i = 0; i < 40; i++) {\n    const m = (lo + hi) / 2, fm = l.e.pointAt(m).x - s;\n    if ((fm < 0) === (flo < 0)) { lo = m; flo = fm; } else hi = m;\n  }\n  const p = l.e.pointAt((lo + hi) / 2);\n  return [p.y, p.z];\n}\n\nfunction uniq(pts: P[]): P[] {\n  const out: P[] = [];\n  for (const p of pts) if (!out.some((q) => Math.hypot(q[0] - p[0], q[1] - p[1]) < 0.5)) out.push(p);\n  return out;\n}\n\n// Outside of the hull at x = s: points from the sheer down the side, then\n// across the bottom to the keel, with the planking thickness of each segment.\nfunction outsideAt(side: any[], bottom: any[], s: number, sideT: number, bottomT: number) {\n  const sp = uniq(side.map((l) => crossX(l, s)).filter((p) => p) as P[]).sort((a, b) => b[1] - a[1]);\n  const bp = uniq(bottom.map((l) => crossX(l, s)).filter((p) => p) as P[]).sort((a, b) => b[0] - a[0]);\n  return joinOutside(sp, bp, sideT, bottomT);\n}\n\nfunction joinOutside(sp: P[], bp: P[], sideT: number, bottomT: number) {\n  if (sp.length < 2) return null;\n  const pts: P[] = [...sp];\n  const t: number[] = sp.slice(1).map(() => sideT);\n  for (const p of bp) {\n    const last = pts[pts.length - 1];\n    if (Math.hypot(last[0] - p[0], last[1] - p[1]) < 0.5) continue; // the chine, shared\n    t.push(bottomT);\n    pts.push(p);\n  }\n  return { pts, t };\n}\n\n// The same outline moved inward by each segment's thickness, corners mitred\n// (or averaged where the segments are nearly in line or the mitre is long).\nfunction inset(O: P[], t: number[]): P[] {\n  const n = O.length, L: any[] = [];\n  for (let i = 0; i < n - 1; i++) {\n    const dy = O[i + 1][0] - O[i][0], dz = O[i + 1][1] - O[i][1], len = Math.hypot(dy, dz) || 1;\n    const v = [dy / len, dz / len], N = [v[1], -v[0]]; // inboard of the side, above the bottom\n    L.push({ p: [O[i][0] + t[i] * N[0], O[i][1] + t[i] * N[1]], v, N, t: t[i] });\n  }\n  const Q: P[] = [L[0].p];\n  for (let j = 1; j < n - 1; j++) {\n    const a = L[j - 1], b = L[j];\n    const mean = [O[j][0] + 0.5 * (a.t * a.N[0] + b.t * b.N[0]), O[j][1] + 0.5 * (a.t * a.N[1] + b.t * b.N[1])];\n    const cr = a.v[0] * b.v[1] - a.v[1] * b.v[0];\n    if (Math.abs(cr) < 0.25) { Q.push(mean); continue; }\n    const k = ((b.p[0] - a.p[0]) * b.v[1] - (b.p[1] - a.p[1]) * b.v[0]) / cr;\n    const q = [a.p[0] + a.v[0] * k, a.p[1] + a.v[1] * k];\n    Q.push(Math.hypot(q[0] - O[j][0], q[1] - O[j][1]) > 3 * Math.max(a.t, b.t) ? mean : q);\n  }\n  const z = L[n - 2];\n  Q.push([O[n - 1][0] + z.t * z.N[0], O[n - 1][1] + z.t * z.N[1]]);\n  return Q;\n}\n\n// Height of the inside of the planking where it passes y = c (going down).\nfunction heightAtY(Q: P[], c: number): number | null {\n  for (let i = 0; i < Q.length - 1; i++) {\n    const a = Q[i], b = Q[i + 1];\n    if (a[0] >= c && b[0] < c) return a[1] + ((b[1] - a[1]) * (a[0] - c)) / (a[0] - b[0]);\n  }\n  return null;\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Keel hog profile: side view of the keel hog, a timber 2 x halfWidth wide and\n * `depth` deep lying on the bottom planking along the centreline, from the\n * transom to x = endX. Its lower edge is where the inside of the planking\n * passes y = halfWidth, so it bears on the planking at its edges; its aft end\n * follows the raked transom. Returns a sketch with X = boat x and Y = boat z\n * for Extrude, Rotate and Move atoms.\n */\nfunction run(hull, endX = 3300, halfWidth = 32, depth = 34, step = 50, rakeDeg = 12.017, xAtKeel = 0.622, sideThickness = 6, bottomThickness = 9) {\n    const side = hullLines(tagged(hull, \"side surface\"));\n    const bottom = hullLines(tagged(hull, \"bottom surface\"));\n    const tr = Math.tan((rakeDeg * Math.PI) / 180);\n    const xs = [];\n    for (let x = 5; x < endX; x += step)\n        xs.push(x);\n    xs.push(endX);\n    const lower = [];\n    for (const x of xs) {\n        const o = outsideAt(side, bottom, x, sideThickness, bottomThickness);\n        const z = o ? heightAtY(inset(o.pts, o.t), halfWidth) : null;\n        if (z !== null)\n            lower.push([x, z]);\n    }\n    if (lower.length < 2)\n        throw new Error(\"No hull sections along the keel\");\n    const z0 = lower[0][1];\n    let pen = replicad.draw([xAtKeel - z0 * tr, z0]); // aft end on the transom plane\n    for (const p of lower)\n        pen = pen.lineTo(p);\n    for (let i = lower.length - 1; i >= 0; i--)\n        pen = pen.lineTo([lower[i][0], lower[i][1] + depth]);\n    pen = pen.lineTo([xAtKeel - (z0 + depth) * tr, z0 + depth]);\n    return new Assembly({ geometry: pen.close(), tags: [\"keel hog\"] });\n}\n// Faces of the hull carrying `tag`, on the face itself or on a group above it.\nfunction tagged(hull, tag) {\n    const out = [];\n    const walk = (node, has) => {\n        const h = has || (node.tags || []).includes(tag);\n        if (Array.isArray(node.geometry))\n            node.geometry.forEach((c) => walk(c, h));\n        else if (h && node.geometry)\n            out.push(node.geometry);\n    };\n    walk(hull, false);\n    return out;\n}\n// The edges of strip faces that run along the boat: the hull lines.\nfunction hullLines(faces) {\n    const out = [];\n    for (const f of faces)\n        for (const e of f.edges) {\n            const a = e.pointAt(0), b = e.pointAt(1);\n            if (Math.abs(b.x - a.x) > 10)\n                out.push({ e, lo: Math.min(a.x, b.x), hi: Math.max(a.x, b.x) });\n        }\n    return out;\n}\n// Where a hull line crosses the plane x = s, as [y, z].\nfunction crossX(l, s) {\n    if (s <= l.lo || s >= l.hi)\n        return null;\n    let lo = 0, hi = 1, flo = l.e.pointAt(0).x - s;\n    if (flo * (l.e.pointAt(1).x - s) > 0)\n        return null;\n    for (let i = 0; i < 40; i++) {\n        const m = (lo + hi) / 2, fm = l.e.pointAt(m).x - s;\n        if ((fm < 0) === (flo < 0)) {\n            lo = m;\n            flo = fm;\n        }\n        else\n            hi = m;\n    }\n    const p = l.e.pointAt((lo + hi) / 2);\n    return [p.y, p.z];\n}\nfunction uniq(pts) {\n    const out = [];\n    for (const p of pts)\n        if (!out.some((q) => Math.hypot(q[0] - p[0], q[1] - p[1]) < 0.5))\n            out.push(p);\n    return out;\n}\n// Outside of the hull at x = s: points from the sheer down the side, then\n// across the bottom to the keel, with the planking thickness of each segment.\nfunction outsideAt(side, bottom, s, sideT, bottomT) {\n    const sp = uniq(side.map((l) => crossX(l, s)).filter((p) => p)).sort((a, b) => b[1] - a[1]);\n    const bp = uniq(bottom.map((l) => crossX(l, s)).filter((p) => p)).sort((a, b) => b[0] - a[0]);\n    return joinOutside(sp, bp, sideT, bottomT);\n}\nfunction joinOutside(sp, bp, sideT, bottomT) {\n    if (sp.length < 2)\n        return null;\n    const pts = [...sp];\n    const t = sp.slice(1).map(() => sideT);\n    for (const p of bp) {\n        const last = pts[pts.length - 1];\n        if (Math.hypot(last[0] - p[0], last[1] - p[1]) < 0.5)\n            continue; // the chine, shared\n        t.push(bottomT);\n        pts.push(p);\n    }\n    return { pts, t };\n}\n// The same outline moved inward by each segment's thickness, corners mitred\n// (or averaged where the segments are nearly in line or the mitre is long).\nfunction inset(O, t) {\n    const n = O.length, L = [];\n    for (let i = 0; i < n - 1; i++) {\n        const dy = O[i + 1][0] - O[i][0], dz = O[i + 1][1] - O[i][1], len = Math.hypot(dy, dz) || 1;\n        const v = [dy / len, dz / len], N = [v[1], -v[0]]; // inboard of the side, above the bottom\n        L.push({ p: [O[i][0] + t[i] * N[0], O[i][1] + t[i] * N[1]], v, N, t: t[i] });\n    }\n    const Q = [L[0].p];\n    for (let j = 1; j < n - 1; j++) {\n        const a = L[j - 1], b = L[j];\n        const mean = [O[j][0] + 0.5 * (a.t * a.N[0] + b.t * b.N[0]), O[j][1] + 0.5 * (a.t * a.N[1] + b.t * b.N[1])];\n        const cr = a.v[0] * b.v[1] - a.v[1] * b.v[0];\n        if (Math.abs(cr) < 0.25) {\n            Q.push(mean);\n            continue;\n        }\n        const k = ((b.p[0] - a.p[0]) * b.v[1] - (b.p[1] - a.p[1]) * b.v[0]) / cr;\n        const q = [a.p[0] + a.v[0] * k, a.p[1] + a.v[1] * k];\n        Q.push(Math.hypot(q[0] - O[j][0], q[1] - O[j][1]) > 3 * Math.max(a.t, b.t) ? mean : q);\n    }\n    const z = L[n - 2];\n    Q.push([O[n - 1][0] + z.t * z.N[0], O[n - 1][1] + z.t * z.N[1]]);\n    return Q;\n}\n// Height of the inside of the planking where it passes y = c (going down).\nfunction heightAtY(Q, c) {\n    for (let i = 0; i < Q.length - 1; i++) {\n        const a = Q[i], b = Q[i + 1];\n        if (a[0] >= c && b[0] < c)\n            return a[1] + ((b[1] - a[1]) * (a[0] - c)) / (a[0] - b[0]);\n    }\n    return null;\n}\n"
