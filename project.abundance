                  "compiledCode": "\"use strict\";\n/**\n * Panel thickness: gives a curved plywood panel surface its thickness.\n * Each strip of the surface (the ruled strips between camber hull lines) is\n * offset along its normals by `thickness` (negative = toward the inside of the\n * hull) and closed into a solid with ruled side walls. The strips are joined\n * as one compound so the panel stays a single part. (Boolean-fusing the strips\n * fails because neighbouring offset surfaces do not share exact edges.)\n */\nfunction run(surface, thickness = -9, color = \"#c9a47a\") {\n    const solids = [];\n    surface.onLeafs((leaf) => {\n        const face = leaf.geometry;\n        const off = replicad.makeOffset(face, thickness).faces[0];\n        const w1 = replicad.assembleWire(face.edges);\n        const w2 = replicad.assembleWire(off.edges);\n        const walls = replicad.loft([w2, w1], {}, true);\n        const shell = replicad.weldShellsAndFaces([face, off, ...walls.faces]);\n        solids.push(replicad.makeSolid([shell]));\n        return leaf;\n    });\n    if (solids.length === 0)\n        throw new Error(\"No faces in the panel surface\");\n    const panel = solids.length === 1 ? solids[0] : replicad.makeCompound(solids);\n    return new Assembly({ geometry: panel, color });\n}\n"
