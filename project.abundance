            {
              "atomType": "Code",
              "x": 0.3,
              "y": 0.2,
              "uniqueID": "id-3283",
              "ioValues": [
                {
                  "name": "hullLines",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "crownRadius",
                  "ioValue": 6000
                },
                {
                  "name": "top",
                  "ioValue": -6,
                  "currentEquation": "3 - DeckThickness"
                },
                {
                  "name": "bottom",
                  "ioValue": -29,
                  "currentEquation": "-(DeckThickness + Depth)"
                },
                {
