          "interpreterVersion": 1,
          "code": "/**\n * Inside-of-planking camber hull definition.\n * Takes the camber hull JSON and returns a copy in which every station's\n * section (its template polyline, in the station plane: n inboard, d down) is\n * offset inward by the planking thickness: `sideThickness` on the segments\n * from the deck edge down to the chine, `bottomThickness` from the chine to\n * past the keel. Corners are mitred (adjacent offset segments intersected);\n * where the segments are nearly in line (the chine fades out at the bow) or\n * the mitre would be long, the corner moves by the mean of the two offsets.\n * The sheer trim is removed so the sides run up to the deck plane; the\n * crowned deck cuts the volume later. Point 0 (the deck edge) stays pinned.\n */\nfunction run(hullJson: string = \"{}\", sideThickness: number = 6, bottomThickness: number = 9, chineIndex: number = 6): string {\n  const hull = JSON.parse(hullJson);\n  hull.sheerTrim = (hull.sheerTrim || []).map((t: any) => ({ ...t, depth: 0 }));\n  hull.templates = hull.templates.map((tpl: any[]) => {\n    const P: number[][] = [];\n    let d = 0;\n    tpl.forEach((pt: any, i: number) => {\n      d = i === 0 ? 0 : d + Number(pt.dd);\n      P.push([i === 0 ? 0 : Number(pt.n), d]);\n    });\n    const m = P.length;\n    const lines = [] as { p: number[]; v: number[]; N: number[]; t: number }[];\n    for (let i = 0; i < m - 1; i++) {\n      const dn = P[i + 1][0] - P[i][0], dd = P[i + 1][1] - P[i][1];\n      const L = Math.hypot(dn, dd) || 1;\n      const v = [dn / L, dd / L];\n      const N = [v[1], -v[0]]; // inward: inboard of the side, above the bottom\n      const t = i < chineIndex ? sideThickness : bottomThickness;\n      lines.push({ p: [P[i][0] + t * N[0], P[i][1] + t * N[1]], v, N, t });\n    }\n    const Q: number[][] = [[0, 0]];\n    for (let j = 1; j < m; j++) {\n      if (j === m - 1) {\n        const a = lines[j - 1];\n        Q.push([P[j][0] + a.t * a.N[0], P[j][1] + a.t * a.N[1]]);\n        continue;\n      }\n      const a = lines[j - 1], b = lines[j];\n      const mean = [P[j][0] + 0.5 * (a.t * a.N[0] + b.t * b.N[0]), P[j][1] + 0.5 * (a.t * a.N[1] + b.t * b.N[1])];\n      const cr = a.v[0] * b.v[1] - a.v[1] * b.v[0];\n      if (Math.abs(cr) < 0.25) { Q.push(mean); continue; }\n      const s = ((b.p[0] - a.p[0]) * b.v[1] - (b.p[1] - a.p[1]) * b.v[0]) / cr;\n      const q = [a.p[0] + a.v[0] * s, a.p[1] + a.v[1] * s];\n      Q.push(Math.hypot(q[0] - P[j][0], q[1] - P[j][1]) > 3 * Math.max(a.t, b.t) ? mean : q);\n    }\n    let prev = 0;\n    return tpl.map((pt: any, i: number) => {\n      if (i === 0) return { ...pt, dd: 0, n: 0 };\n      let dd = Q[i][1] - prev;\n      if (!(dd > 0.01)) dd = 0.01;\n      prev += dd;\n      return { ...pt, dd, n: Q[i][0] };\n    });\n  });\n  return JSON.stringify(hull);\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Inside-of-planking camber hull definition.\n * Takes the camber hull JSON and returns a copy in which every station's\n * section (its template polyline, in the station plane: n inboard, d down) is\n * offset inward by the planking thickness: `sideThickness` on the segments\n * from the deck edge down to the chine, `bottomThickness` from the chine to\n * past the keel. Corners are mitred (adjacent offset segments intersected);\n * where the segments are nearly in line (the chine fades out at the bow) or\n * the mitre would be long, the corner moves by the mean of the two offsets.\n * The sheer trim is removed so the sides run up to the deck plane; the\n * crowned deck cuts the volume later. Point 0 (the deck edge) stays pinned.\n */\nfunction run(hullJson = \"{}\", sideThickness = 6, bottomThickness = 9, chineIndex = 6) {\n    const hull = JSON.parse(hullJson);\n    hull.sheerTrim = (hull.sheerTrim || []).map((t) => ({ ...t, depth: 0 }));\n    hull.templates = hull.templates.map((tpl) => {\n        const P = [];\n        let d = 0;\n        tpl.forEach((pt, i) => {\n            d = i === 0 ? 0 : d + Number(pt.dd);\n            P.push([i === 0 ? 0 : Number(pt.n), d]);\n        });\n        const m = P.length;\n        const lines = [];\n        for (let i = 0; i < m - 1; i++) {\n            const dn = P[i + 1][0] - P[i][0], dd = P[i + 1][1] - P[i][1];\n            const L = Math.hypot(dn, dd) || 1;\n            const v = [dn / L, dd / L];\n            const N = [v[1], -v[0]]; // inward: inboard of the side, above the bottom\n            const t = i < chineIndex ? sideThickness : bottomThickness;\n            lines.push({ p: [P[i][0] + t * N[0], P[i][1] + t * N[1]], v, N, t });\n        }\n        const Q = [[0, 0]];\n        for (let j = 1; j < m; j++) {\n            if (j === m - 1) {\n                const a = lines[j - 1];\n                Q.push([P[j][0] + a.t * a.N[0], P[j][1] + a.t * a.N[1]]);\n                continue;\n            }\n            const a = lines[j - 1], b = lines[j];\n            const mean = [P[j][0] + 0.5 * (a.t * a.N[0] + b.t * b.N[0]), P[j][1] + 0.5 * (a.t * a.N[1] + b.t * b.N[1])];\n            const cr = a.v[0] * b.v[1] - a.v[1] * b.v[0];\n            if (Math.abs(cr) < 0.25) {\n                Q.push(mean);\n                continue;\n            }\n            const s = ((b.p[0] - a.p[0]) * b.v[1] - (b.p[1] - a.p[1]) * b.v[0]) / cr;\n            const q = [a.p[0] + a.v[0] * s, a.p[1] + a.v[1] * s];\n            Q.push(Math.hypot(q[0] - P[j][0], q[1] - P[j][1]) > 3 * Math.max(a.t, b.t) ? mean : q);\n        }\n        let prev = 0;\n        return tpl.map((pt, i) => {\n            if (i === 0)\n                return { ...pt, dd: 0, n: 0 };\n            let dd = Q[i][1] - prev;\n            if (!(dd > 0.01))\n                dd = 0.01;\n            prev += dd;\n            return { ...pt, dd, n: Q[i][0] };\n        });\n    });\n    return JSON.stringify(hull);\n}\n"
        },
        {
          "atomType": "GitHubMolecule",
