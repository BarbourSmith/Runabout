                  "interpreterVersion": 1,
                  "code": "/**\n * Deck batten plan: seen from above, a band `width` wide centred on the curve\n * that sits at `fraction` of the local half-beam (0 = centreline, 1 = sheer).\n * It runs from the transom end of the sheer (the top edge of the hull surface)\n * forward and stops where it would come within `stopY` of the centreline (the\n * king plank). Its edges are smooth curves (Catmull-Rom, as cubic Beziers), so\n * the batten's prism has few faces and its boolean with the deck layer is fast.\n */\nfunction run(hull: Assembly, fraction: number = 0.29, width: number = 40, stopY: number = 60, samples: number = 32): Assembly {\n  const sheer = sheerOf(hull);\n  const n = Math.max(8, Math.round(samples));\n  const c: number[][] = [];\n  let lastX = -Infinity;\n  for (let i = 0; i <= n; i++) {\n    const p = sheer.pointAt(i / n);\n    if (p.x <= lastX + 0.5) continue;\n    const y = fraction * Math.max(0, p.y);\n    if (c.length > 2 && y - width / 2 < stopY) break;\n    lastX = p.x;\n    c.push([p.x, y]);\n  }\n  const left: number[][] = [], right: number[][] = [];\n  for (let i = 0; i < c.length; i++) {\n    const a = c[Math.max(0, i - 1)], b = c[Math.min(c.length - 1, i + 1)];\n    const tx = b[0] - a[0], ty = b[1] - a[1], L = Math.hypot(tx, ty) || 1;\n    const nx = -ty / L, ny = tx / L;\n    left.push([c[i][0] + (nx * width) / 2, c[i][1] + (ny * width) / 2]);\n    right.push([c[i][0] - (nx * width) / 2, c[i][1] - (ny * width) / 2]);\n  }\n  let pen = replicad.draw(left[0]);\n  pen = smooth(pen, left);\n  const back = right.slice().reverse();\n  pen = pen.lineTo(back[0]);\n  pen = smooth(pen, back);\n  return new Assembly({ geometry: pen.close() });\n}\n\n// Continue the pen through pts[1..] on a Catmull-Rom curve (cubic Beziers).\nfunction smooth(pen: any, pts: number[][]): any {\n  const n = pts.length;\n  const p = (i: number) => pts[Math.max(0, Math.min(n - 1, i))];\n  for (let i = 0; i < n - 1; i++) {\n    const [a, b, c, d] = [p(i - 1), p(i), p(i + 1), p(i + 2)];\n    const c1 = [b[0] + (c[0] - a[0]) / 6, b[1] + (c[1] - a[1]) / 6];\n    const c2 = [c[0] - (d[0] - b[0]) / 6, c[1] - (d[1] - b[1]) / 6];\n    pen = pen.cubicBezierCurveTo(c, c1, c2);\n  }\n  return pen;\n}\n\n// The sheer: the highest edge of the hull surface that runs along the boat,\n// read so that pointAt(0) is its aft end (at the transom).\nfunction sheerOf(hull: Assembly): any {\n  let best: any = null, bestZ = -Infinity;\n  hull.onLeafs((leaf: any) => {\n    const g: any = leaf.geometry;\n    if (g && g.edges) for (const e of g.edges) {\n      const a = e.pointAt(0), b = e.pointAt(1);\n      if (Math.abs(b.x - a.x) < 1000) continue;\n      const z = e.pointAt(0.5).z;\n      if (z > bestZ) { bestZ = z; best = e; }\n    }\n    return leaf;\n  });\n  if (!best) throw new Error(\"No sheer edge in the hull surface\");\n  const fwd = best.pointAt(1).x > best.pointAt(0).x;\n  return { pointAt: (t: number) => best.pointAt(fwd ? t : 1 - t) };\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Deck batten plan: seen from above, a band `width` wide centred on the curve\n * that sits at `fraction` of the local half-beam (0 = centreline, 1 = sheer).\n * It runs from the transom end of the sheer (the top edge of the hull surface)\n * forward and stops where it would come within `stopY` of the centreline (the\n * king plank). Its edges are smooth curves (Catmull-Rom, as cubic Beziers), so\n * the batten's prism has few faces and its boolean with the deck layer is fast.\n */\nfunction run(hull, fraction = 0.29, width = 40, stopY = 60, samples = 32) {\n    const sheer = sheerOf(hull);\n    const n = Math.max(8, Math.round(samples));\n    const c = [];\n    let lastX = -Infinity;\n    for (let i = 0; i <= n; i++) {\n        const p = sheer.pointAt(i / n);\n        if (p.x <= lastX + 0.5)\n            continue;\n        const y = fraction * Math.max(0, p.y);\n        if (c.length > 2 && y - width / 2 < stopY)\n            break;\n        lastX = p.x;\n        c.push([p.x, y]);\n    }\n    const left = [], right = [];\n    for (let i = 0; i < c.length; i++) {\n        const a = c[Math.max(0, i - 1)], b = c[Math.min(c.length - 1, i + 1)];\n        const tx = b[0] - a[0], ty = b[1] - a[1], L = Math.hypot(tx, ty) || 1;\n        const nx = -ty / L, ny = tx / L;\n        left.push([c[i][0] + (nx * width) / 2, c[i][1] + (ny * width) / 2]);\n        right.push([c[i][0] - (nx * width) / 2, c[i][1] - (ny * width) / 2]);\n    }\n    let pen = replicad.draw(left[0]);\n    pen = smooth(pen, left);\n    const back = right.slice().reverse();\n    pen = pen.lineTo(back[0]);\n    pen = smooth(pen, back);\n    return new Assembly({ geometry: pen.close() });\n}\n// Continue the pen through pts[1..] on a Catmull-Rom curve (cubic Beziers).\nfunction smooth(pen, pts) {\n    const n = pts.length;\n    const p = (i) => pts[Math.max(0, Math.min(n - 1, i))];\n    for (let i = 0; i < n - 1; i++) {\n        const [a, b, c, d] = [p(i - 1), p(i), p(i + 1), p(i + 2)];\n        const c1 = [b[0] + (c[0] - a[0]) / 6, b[1] + (c[1] - a[1]) / 6];\n        const c2 = [c[0] - (d[0] - b[0]) / 6, c[1] - (d[1] - b[1]) / 6];\n        pen = pen.cubicBezierCurveTo(c, c1, c2);\n    }\n    return pen;\n}\n// The sheer: the highest edge of the hull surface that runs along the boat,\n// read so that pointAt(0) is its aft end (at the transom).\nfunction sheerOf(hull) {\n    let best = null, bestZ = -Infinity;\n    hull.onLeafs((leaf) => {\n        const g = leaf.geometry;\n        if (g && g.edges)\n            for (const e of g.edges) {\n                const a = e.pointAt(0), b = e.pointAt(1);\n                if (Math.abs(b.x - a.x) < 1000)\n                    continue;\n                const z = e.pointAt(0.5).z;\n                if (z > bestZ) {\n                    bestZ = z;\n                    best = e;\n                }\n            }\n        return leaf;\n    });\n    if (!best)\n        throw new Error(\"No sheer edge in the hull surface\");\n    const fwd = best.pointAt(1).x > best.pointAt(0).x;\n    return { pointAt: (t) => best.pointAt(fwd ? t : 1 - t) };\n}\n"
                },
