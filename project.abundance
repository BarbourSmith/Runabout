                  "ioValue": "{   \"keelK\": [     1,     0   ],   \"length\": 1000,   \"transom\": {     \"x\": 0,     \"depthTop\": 0,     \"dDepthBot\": 192.6993751525879,     \"transomRake\": 0   },   \"sheerPlan\": [     {       \"w\": [         0.3000607248079979,         0.6999392751920022       ],       \"y\": -1.80450439453125,       \"dx\": 0     },     {       \"w\": [         0.999,         0.0010000000000000009       ],       \"y\": 102.89400100708008,       \"dx\": 345.50304412841797     },     {       \"w\": [         0.999,         0.0010000000000000009       ],       \"y\": 102.89400100708008,       \"dx\": 244.74193572998047     },     {       \"w\": [         0.3080382266287076,         0.6919617733712924       ],       \"y\": -6.117744445800781,       \"dx\": 407.91648864746094     }   ],   \"sheerTrim\": [     {       \"k\": 0,       \"dx\": 0,       \"depth\": 24.588298797607422     },     {       \"k\": 0,       \"dx\": 334.91233825683594,       \"depth\": 31.12346649169922     },     {       \"k\": 0,       \"dx\": 296.5155029296875,       \"depth\": 25.24022102355957     },     {       \"k\": 0,       \"dx\": 358.1029510498047,       \"depth\": 0     }   ],   \"templates\": [     [       {         \"k\": 0,         \"n\": 0,         \"dd\": 0       },       {         \"k\": 1,         \"n\": -1.1425113677978658,         \"dd\": 0       },       {         \"k\": 1,         \"n\": 8.620316914149683,         \"dd\": 62.679800578526084       },       {         \"k\": 1,         \"n\": 85.46447208949496,         \"dd\": 14.515009198869976       }     ],     [       {         \"k\": 0,         \"n\": 0,         \"dd\": 0       },       {         \"k\": 1,         \"n\": -1.1425113677978658,         \"dd\": 0       },       {         \"k\": 1,         \"n\": 11.181677409580772,         \"dd\": 43.89566544124058       },       {         \"k\": 1,         \"n\": -16.994405201503213,         \"dd\": 27.322431700570235       }     ]   ],   \"waterline\": 50,   \"deckRakeDeg\": 0 }",
                  "currentEquation": "{   \"keelK\": [     1,     0   ],   \"length\": 1000,   \"transom\": {     \"x\": 0,     \"depthTop\": 0,     \"dDepthBot\": 192.6993751525879,     \"transomRake\": 0   },   \"sheerPlan\": [     {       \"w\": [         0.3000607248079979,         0.6999392751920022       ],       \"y\": -1.80450439453125,       \"dx\": 0     },     {       \"w\": [         0.999,         0.0010000000000000009       ],       \"y\": 102.89400100708008,       \"dx\": 345.50304412841797     },     {       \"w\": [         0.999,         0.0010000000000000009       ],       \"y\": 102.89400100708008,       \"dx\": 244.74193572998047     },     {       \"w\": [         0.3080382266287076,         0.6919617733712924       ],       \"y\": -6.117744445800781,       \"dx\": 407.91648864746094     }   ],   \"sheerTrim\": [     {       \"k\": 0,       \"dx\": 0,       \"depth\": 24.588298797607422     },     {       \"k\": 0,       \"dx\": 334.91233825683594,       \"depth\": 31.12346649169922     },     {       \"k\": 0,       \"dx\": 296.5155029296875,       \"depth\": 25.24022102355957     },     {       \"k\": 0,       \"dx\": 358.1029510498047,       \"depth\": 0     }   ],   \"templates\": [     [       {         \"k\": 0,         \"n\": 0,         \"dd\": 0       },       {         \"k\": 1,         \"n\": -1.1425113677978658,         \"dd\": 0       },       {         \"k\": 1,         \"n\": 8.620316914149683,         \"dd\": 62.679800578526084       },       {         \"k\": 1,         \"n\": 85.46447208949496,         \"dd\": 14.515009198869976       }     ],     [       {         \"k\": 0,         \"n\": 0,         \"dd\": 0       },       {         \"k\": 1,         \"n\": -1.1425113677978658,         \"dd\": 0       },       {         \"k\": 1,         \"n\": 11.181677409580772,         \"dd\": 43.89566544124058       },       {         \"k\": 1,         \"n\": -16.994405201503213,         \"dd\": 27.322431700570235       }     ]   ],   \"waterline\": 50,   \"deckRakeDeg\": 0 }"
                }
