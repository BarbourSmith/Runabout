                  "code": "/**\n * Hull-hugging timber member on chosen planking strips of the hull surface.\n * sideStrips counts the side strips from the sheer down; bottomStrips counts\n * the bottom strips from the chine to the keel. Each strip is offset inward by\n * `inset` (the planking, giving the face that bears on it) and by `thickness`\n * (planking plus the member's depth, its back face) and closed into a solid\n * with ruled side walls, so the member follows the twist of the planking.\n */\nfunction run(hull: Assembly, sideStrips: number[] = [], bottomStrips: number[] = [4], inset: number = 9, thickness: number = -29, color: string = \"#b5835a\"): Assembly {\n  const faces = [\n    ...pick(hull, \"side surface\", sideStrips, (c) => c[2]),\n    ...pick(hull, \"bottom surface\", bottomStrips, (c) => c[1]),\n  ];\n  if (faces.length === 0) throw new Error(\"No strips chosen for the member\");\n  const solids: any[] = [];\n  for (const face of faces) {\n    const inner = (replicad.makeOffset(face, -Math.abs(inset)) as any).faces[0];\n    const back = (replicad.makeOffset(face, thickness) as any).faces[0];\n    const w1 = replicad.assembleWire(inner.edges);\n    const w2 = replicad.assembleWire(back.edges);\n    const walls: any = replicad.loft([w2, w1], {}, true);\n    const shell = replicad.weldShellsAndFaces([inner, back, ...walls.faces]);\n    solids.push(replicad.makeSolid([shell]));\n  }\n  const member = solids.length === 1 ? solids[0] : replicad.makeCompound(solids);\n  return new Assembly({ geometry: member, color });\n}\n\n// Strips with `tag`, ordered by key(centre) from high to low, picked by index.\nfunction pick(hull: any, tag: string, which: number[], key: (c: number[]) => number): any[] {\n  const faces: any[] = [];\n  const walk = (node: any, has: boolean) => {\n    const h = has || (node.tags || []).includes(tag);\n    if (Array.isArray(node.geometry)) node.geometry.forEach((c: any) => walk(c, h));\n    else if (h && node.geometry) faces.push(node.geometry);\n  };\n  walk(hull, false);\n  const centre = (f: any) => {\n    const s = [0, 0, 0];\n    let n = 0;\n    for (const e of f.edges) { const p = e.pointAt(0.5); s[0] += p.x; s[1] += p.y; s[2] += p.z; n++; }\n    return s.map((v) => v / n);\n  };\n  const sorted = faces.map((f) => ({ f, k: key(centre(f)) })).sort((a, b) => b.k - a.k);\n  return (which || []).map((i: number) => {\n    if (!sorted[Number(i)]) throw new Error(`No ${tag} strip ${i} (there are ${sorted.length})`);\n    return sorted[Number(i)].f;\n  });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Hull-hugging timber member on chosen planking strips of the hull surface.\n * sideStrips counts the side strips from the sheer down; bottomStrips counts\n * the bottom strips from the chine to the keel. Each strip is offset inward by\n * `inset` (the planking, giving the face that bears on it) and by `thickness`\n * (planking plus the member's depth, its back face) and closed into a solid\n * with ruled side walls, so the member follows the twist of the planking.\n */\nfunction run(hull, sideStrips = [], bottomStrips = [4], inset = 9, thickness = -29, color = \"#b5835a\") {\n    const faces = [\n        ...pick(hull, \"side surface\", sideStrips, (c) => c[2]),\n        ...pick(hull, \"bottom surface\", bottomStrips, (c) => c[1]),\n    ];\n    if (faces.length === 0)\n        throw new Error(\"No strips chosen for the member\");\n    const solids = [];\n    for (const face of faces) {\n        const inner = replicad.makeOffset(face, -Math.abs(inset)).faces[0];\n        const back = replicad.makeOffset(face, thickness).faces[0];\n        const w1 = replicad.assembleWire(inner.edges);\n        const w2 = replicad.assembleWire(back.edges);\n        const walls = replicad.loft([w2, w1], {}, true);\n        const shell = replicad.weldShellsAndFaces([inner, back, ...walls.faces]);\n        solids.push(replicad.makeSolid([shell]));\n    }\n    const member = solids.length === 1 ? solids[0] : replicad.makeCompound(solids);\n    return new Assembly({ geometry: member, color });\n}\n// Strips with `tag`, ordered by key(centre) from high to low, picked by index.\nfunction pick(hull, tag, which, key) {\n    const faces = [];\n    const walk = (node, has) => {\n        const h = has || (node.tags || []).includes(tag);\n        if (Array.isArray(node.geometry))\n            node.geometry.forEach((c) => walk(c, h));\n        else if (h && node.geometry)\n            faces.push(node.geometry);\n    };\n    walk(hull, false);\n    const centre = (f) => {\n        const s = [0, 0, 0];\n        let n = 0;\n        for (const e of f.edges) {\n            const p = e.pointAt(0.5);\n            s[0] += p.x;\n            s[1] += p.y;\n            s[2] += p.z;\n            n++;\n        }\n        return s.map((v) => v / n);\n    };\n    const sorted = faces.map((f) => ({ f, k: key(centre(f)) })).sort((a, b) => b.k - a.k);\n    return (which || []).map((i) => {\n        if (!sorted[Number(i)])\n            throw new Error(`No ${tag} strip ${i} (there are ${sorted.length})`);\n        return sorted[Number(i)].f;\n    });\n}\n"
                },
