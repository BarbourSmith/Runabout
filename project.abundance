            }
          ]
        },
        {
          "atomType": "Input",
          "x": 0.0254,
          "y": 0.1538,
          "uniqueID": "id-433",
          "name": "Hull Lines",
          "type": "number",
          "options": []
        },
        {
          "atomType": "Input",
          "x": 0.0254,
          "y": 0.2462,
          "uniqueID": "id-436",
          "name": "CrownRadius",
          "type": "number",
          "options": []
        },
        {
          "atomType": "Code",
          "x": 0.4,
          "y": 0.45,
          "uniqueID": "id-439",
          "ioValues": [
            {
              "name": "hullLines",
              "ioValue": "__GEOMETRY_INPUT__"
            },
            {
              "name": "crownRadius",
              "ioValue": 6000
            },
            {
              "name": "samples",
              "ioValue": 48
            }
          ],
          "interpreterVersion": 1,
          "code": "/**\n * Deck crown volume.\n * The deck of the runabout is crowned with a constant radius: at every\n * station it is a circular arc of radius `crownRadius` passing through the\n * port and starboard sheer points. This samples the sheer wire (the hull-lines\n * wire tagged \"sheer\") and lofts a full circle of that radius at each sample,\n * centred on the boat's centreline below the sheer. Everything inside the\n * result is under the deck; intersect it with the hull interior to give the\n * frames, transom and stem their crowned tops.\n */\nfunction run(hullLines: Assembly, crownRadius: number = 6000, samples: number = 48): Assembly {\n  let sheer: any = undefined;\n  hullLines.onLeafs((leaf) => {\n    if (!sheer && leaf.isWire() && (leaf.tags || []).includes(\"sheer\")) {\n      sheer = leaf.geometry;\n    }\n    return leaf;\n  });\n  if (!sheer) throw new Error(\"No wire tagged 'sheer' in the hull lines\");\n\n  const R = crownRadius;\n  const n = Math.max(4, Math.round(samples));\n  const wires: any[] = [];\n  let lastX = -Infinity;\n  for (let i = 0; i <= n; i++) {\n    const p = sheer.pointAt(i / n);\n    const x = p.x;\n    if (x <= lastX + 1) continue; // stations must advance along the boat\n    lastX = x;\n    const half = Math.min(Math.abs(p.y), R * 0.999);\n    // centre of the crown arc: on the centreline, below the sheer point\n    const zc = p.z - Math.sqrt(R * R - half * half);\n    const circle = replicad.makeCircle(R, [x, 0, zc], [1, 0, 0]);\n    wires.push(replicad.assembleWire([circle]));\n  }\n  console.log(`deck crown: ${wires.length} sections from x=${wires.length ? \"ok\" : \"none\"}`);\n  const solid = replicad.loft(wires, { ruled: false }, false);\n  return new Assembly({ geometry: solid, color: \"#c8b08a\", tags: [\"deck crown volume\"] });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Deck crown volume.\n * The deck of the runabout is crowned with a constant radius: at every\n * station it is a circular arc of radius `crownRadius` passing through the\n * port and starboard sheer points. This samples the sheer wire (the hull-lines\n * wire tagged \"sheer\") and lofts a full circle of that radius at each sample,\n * centred on the boat's centreline below the sheer. Everything inside the\n * result is under the deck; intersect it with the hull interior to give the\n * frames, transom and stem their crowned tops.\n */\nfunction run(hullLines, crownRadius = 6000, samples = 48) {\n    let sheer = undefined;\n    hullLines.onLeafs((leaf) => {\n        if (!sheer && leaf.isWire() && (leaf.tags || []).includes(\"sheer\")) {\n            sheer = leaf.geometry;\n        }\n        return leaf;\n    });\n    if (!sheer)\n        throw new Error(\"No wire tagged 'sheer' in the hull lines\");\n    const R = crownRadius;\n    const n = Math.max(4, Math.round(samples));\n    const wires = [];\n    let lastX = -Infinity;\n    for (let i = 0; i <= n; i++) {\n        const p = sheer.pointAt(i / n);\n        const x = p.x;\n        if (x <= lastX + 1)\n            continue; // stations must advance along the boat\n        lastX = x;\n        const half = Math.min(Math.abs(p.y), R * 0.999);\n        // centre of the crown arc: on the centreline, below the sheer point\n        const zc = p.z - Math.sqrt(R * R - half * half);\n        const circle = replicad.makeCircle(R, [x, 0, zc], [1, 0, 0]);\n        wires.push(replicad.assembleWire([circle]));\n    }\n    console.log(`deck crown: ${wires.length} sections from x=${wires.length ? \"ok\" : \"none\"}`);\n    const solid = replicad.loft(wires, { ruled: false }, false);\n    return new Assembly({ geometry: solid, color: \"#c8b08a\", tags: [\"deck crown volume\"] });\n}\n"
        }
      ],
