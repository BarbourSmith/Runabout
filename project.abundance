          "code": "/**\n * Extended hull lines for the hull interior volume.\n * Returns the camber hull document unchanged except that every sheerTrim\n * depth is zero, so CamberToWires sweeps the hull sides all the way up to\n * the flat deck plane instead of stopping at the real sheer. The interior\n * volume built from these lines is then cut down to the crowned deck.\n */\nfunction run(hullJson: string = \"{}\"): string {\n  const doc = JSON.parse(hullJson);\n  if (!Array.isArray(doc.sheerTrim)) {\n    throw new Error(\"Hull JSON has no sheerTrim array\");\n  }\n  doc.sheerTrim = doc.sheerTrim.map((t: any) => ({ ...t, depth: 0 }));\n  return JSON.stringify(doc);\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Extended hull lines for the hull interior volume.\n * Returns the camber hull document unchanged except that every sheerTrim\n * depth is zero, so CamberToWires sweeps the hull sides all the way up to\n * the flat deck plane instead of stopping at the real sheer. The interior\n * volume built from these lines is then cut down to the crowned deck.\n */\nfunction run(hullJson = \"{}\") {\n    const doc = JSON.parse(hullJson);\n    if (!Array.isArray(doc.sheerTrim)) {\n        throw new Error(\"Hull JSON has no sheerTrim array\");\n    }\n    doc.sheerTrim = doc.sheerTrim.map((t) => ({ ...t, depth: 0 }));\n    return JSON.stringify(doc);\n}\n"
        },
