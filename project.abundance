            {
              "atomType": "Code",
              "x": 0.45,
              "y": 0.5,
              "uniqueID": "id-6470",
              "ioValues": [
                {
                  "name": "hull",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "startX",
                  "ioValue": 3300
                },
                {
                  "name": "halfWidth",
                  "ioValue": 18
                },
                {
                  "name": "step",
                  "ioValue": 10
                },
                {
                  "name": "sideThickness",
                  "ioValue": 6
                },
                {
                  "name": "bottomThickness",
