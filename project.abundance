              "interpreterVersion": 1,
              "code": "/**\n * Deck batten plan: seen from above, a band `width` wide centred on the curve\n * that sits at `fraction` of the local half-beam (0 = centreline, 1 = sheer).\n * It runs from the aft end of the sheer line forward and stops where it would\n * come within `stopY` of the centreline (the king plank).\n */\nfunction run(hullLines: Assembly, fraction: number = 0.29, width: number = 40, stopY: number = 60, samples: number = 200): Assembly {\n  let sheer: any = undefined;\n  hullLines.onLeafs((leaf) => {\n    if (!sheer && leaf.isWire() && (leaf.tags || []).includes(\"sheer\")) sheer = leaf.geometry;\n    return leaf;\n  });\n  if (!sheer) throw new Error(\"No wire tagged 'sheer' in the hull lines\");\n  const n = Math.max(8, Math.round(samples));\n  const c: number[][] = [];\n  let lastX = -Infinity;\n  for (let i = 0; i <= n; i++) {\n    const p = sheer.pointAt(i / n);\n    if (p.x <= lastX + 0.5) continue;\n    const y = fraction * Math.max(0, p.y);\n    if (c.length > 2 && y - width / 2 < stopY) break;\n    lastX = p.x;\n    c.push([p.x, y]);\n  }\n  const left: number[][] = [], right: number[][] = [];\n  for (let i = 0; i < c.length; i++) {\n    const a = c[Math.max(0, i - 1)], b = c[Math.min(c.length - 1, i + 1)];\n    const tx = b[0] - a[0], ty = b[1] - a[1], L = Math.hypot(tx, ty) || 1;\n    const nx = -ty / L, ny = tx / L;\n    left.push([c[i][0] + (nx * width) / 2, c[i][1] + (ny * width) / 2]);\n    right.push([c[i][0] - (nx * width) / 2, c[i][1] - (ny * width) / 2]);\n  }\n  let pen = replicad.draw(left[0]);\n  for (let i = 1; i < left.length; i++) pen = pen.lineTo(left[i]);\n  for (let i = right.length - 1; i >= 0; i--) pen = pen.lineTo(right[i]);\n  return new Assembly({ geometry: pen.close() });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Deck batten plan: seen from above, a band `width` wide centred on the curve\n * that sits at `fraction` of the local half-beam (0 = centreline, 1 = sheer).\n * It runs from the aft end of the sheer line forward and stops where it would\n * come within `stopY` of the centreline (the king plank).\n */\nfunction run(hullLines, fraction = 0.29, width = 40, stopY = 60, samples = 200) {\n    let sheer = undefined;\n    hullLines.onLeafs((leaf) => {\n        if (!sheer && leaf.isWire() && (leaf.tags || []).includes(\"sheer\"))\n            sheer = leaf.geometry;\n        return leaf;\n    });\n    if (!sheer)\n        throw new Error(\"No wire tagged 'sheer' in the hull lines\");\n    const n = Math.max(8, Math.round(samples));\n    const c = [];\n    let lastX = -Infinity;\n    for (let i = 0; i <= n; i++) {\n        const p = sheer.pointAt(i / n);\n        if (p.x <= lastX + 0.5)\n            continue;\n        const y = fraction * Math.max(0, p.y);\n        if (c.length > 2 && y - width / 2 < stopY)\n            break;\n        lastX = p.x;\n        c.push([p.x, y]);\n    }\n    const left = [], right = [];\n    for (let i = 0; i < c.length; i++) {\n        const a = c[Math.max(0, i - 1)], b = c[Math.min(c.length - 1, i + 1)];\n        const tx = b[0] - a[0], ty = b[1] - a[1], L = Math.hypot(tx, ty) || 1;\n        const nx = -ty / L, ny = tx / L;\n        left.push([c[i][0] + (nx * width) / 2, c[i][1] + (ny * width) / 2]);\n        right.push([c[i][0] - (nx * width) / 2, c[i][1] - (ny * width) / 2]);\n    }\n    let pen = replicad.draw(left[0]);\n    for (let i = 1; i < left.length; i++)\n        pen = pen.lineTo(left[i]);\n    for (let i = right.length - 1; i >= 0; i--)\n        pen = pen.lineTo(right[i]);\n    return new Assembly({ geometry: pen.close() });\n}\n"
            },
