                  "interpreterVersion": 1,
                  "code": "/**\n * Whole symmetric part from its starboard half: each part in the input is\n * fused with its own mirror image across the boat's centreline plane (XZ).\n */\nfunction run(halves: Assembly): Assembly {\n  return halves.onLeafs((leaf) => {\n    const g = leaf.geometry as any;\n    leaf.geometry = g.fuse(g.clone().mirror(\"XZ\"));\n    return leaf;\n  });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Whole symmetric part from its starboard half: each part in the input is\n * fused with its own mirror image across the boat's centreline plane (XZ).\n */\nfunction run(halves) {\n    return halves.onLeafs((leaf) => {\n        const g = leaf.geometry;\n        leaf.geometry = g.fuse(g.clone().mirror(\"XZ\"));\n        return leaf;\n    });\n}\n"
