r(\"Only open wires allowed for this loft operation\");\n            }\n            wireList.push(leaf.geometry);\n        }\n        return leaf;\n    });\n    const result = [];\n    for (let i = 0; i < wireList.length - 1; i++) {\n        const surf = replicad.loft(wireList.slice(i, i + 2), {}, true);\n        if (thickness != 0) {\n            const offset = replicad.makeOffset(surf.faces[0], thickness);\n            const w1 = replicad.assembleWire(surf.edges);\n            const w2 = replicad.assembleWire(offset.edges);\n            const boundary = replicad.loft([w2, w1], {}, true);\n            const validFaces = [...surf.faces, ...offset.faces, ...boundary.faces].filter((f) => { return replicad.measureArea(f) > TOLERANCE; });\n            result.push(new Assembly({\n                geometry: replicad.makeSolid(validFaces)\n            }));\n        }\n        else {\n            result.push(...surf.faces.filter((f) => { return replicad.measureArea(f) > TOLERANCE; }));\n        }\n    }\n    return result;\n}\n"
