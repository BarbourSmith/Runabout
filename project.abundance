                },
                {
                  "name": "color",
                  "ioValue": "#b5835a",
                  "currentEquation": "#b5835a"
                }
              ],
              "interpreterVersion": 1,
              "code": "/**\n * Hull-hugging timber member: the member's footprint strip(s) on the hull\n * surface are offset inward by `inset` (the planking thickness, giving the\n * face that bears on the inside of the planking) and by `thickness` (the\n * planking plus the member's depth, the member's back face). Each strip is\n * closed into a solid between those two offset faces with ruled side walls,\n * so the member follows the twist of the planking exactly.\n */\nfunction run(surface: Assembly, inset: number = 6, thickness: number = -26, color: string = \"#b5835a\"): Assembly {\n  const solids: any[] = [];\n  surface.onLeafs((leaf) => {\n    const face = leaf.geometry as any;\n    const inner = (replicad.makeOffset(face, -Math.abs(inset)) as any).faces[0];\n    const back = (replicad.makeOffset(face, thickness) as any).faces[0];\n    const w1 = replicad.assembleWire(inner.edges);\n    const w2 = replicad.assembleWire(back.edges);\n    const walls: any = replicad.loft([w2, w1], {}, true);\n    const shell = replicad.weldShellsAndFaces([inner, back, ...walls.faces]);\n    solids.push(replicad.makeSolid([shell]));\n    return leaf;\n  });\n  if (solids.length === 0) throw new Error(\"No faces in the member footprint\");\n  const member = solids.length === 1 ? solids[0] : replicad.makeCompound(solids);\n  return new Assembly({ geometry: member, color });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Hull-hugging timber member: the member's footprint strip(s) on the hull\n * surface are offset inward by `inset` (the planking thickness, giving the\n * face that bears on the inside of the planking) and by `thickness` (the\n * planking plus the member's depth, the member's back face). Each strip is\n * closed into a solid between those two offset faces with ruled side walls,\n * so the member follows the twist of the planking exactly.\n */\nfunction run(surface, inset = 6, thickness = -26, color = \"#b5835a\") {\n    const solids = [];\n    surface.onLeafs((leaf) => {\n        const face = leaf.geometry;\n        const inner = replicad.makeOffset(face, -Math.abs(inset)).faces[0];\n        const back = replicad.makeOffset(face, thickness).faces[0];\n        const w1 = replicad.assembleWire(inner.edges);\n        const w2 = replicad.assembleWire(back.edges);\n        const walls = replicad.loft([w2, w1], {}, true);\n        const shell = replicad.weldShellsAndFaces([inner, back, ...walls.faces]);\n        solids.push(replicad.makeSolid([shell]));\n        return leaf;\n    });\n    if (solids.length === 0)\n        throw new Error(\"No faces in the member footprint\");\n    const member = solids.length === 1 ? solids[0] : replicad.makeCompound(solids);\n    return new Assembly({ geometry: member, color });\n}\n"
            }
