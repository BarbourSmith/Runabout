                  "readMeText": "Mirror a given shape",
                  "global": true
                },
                {
                  "atomType": "Rotate",
                  "x": 0.4964,
                  "y": 0.7733,
                  "uniqueID": "id-6672",
                  "ioValues": [
                    {
                      "name": "geometry",
